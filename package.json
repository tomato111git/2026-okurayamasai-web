{
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "cpx": "^1.5.0",
    "ejs-cli": "^2.2.3",
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "build:html": "ejs-cli -b src -o docs/ \"*.ejs\"",
    "build:copy": "cpx \"src/**/*.{css,js,png,jpg,svg}\" docs",
    "build": "run-s build:*",
    "watch:html": "chokidar \"src/**/*.ejs\" -c \"npm run build:html\" --initial",
    "watch:copy": "cpx \"src/**/*.{css,js,png,jpg,svg}\" docs -w",
    "watch": "run-p watch:*"
  }
}