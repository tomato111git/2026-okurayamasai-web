<%const faqList = [
    {
        q: '大倉山祭の開催場所と日程を教えてください。',
        a: '大倉山祭2026は11月1日(土)に大倉山祭の噴水広場で開催します。開催時間は9:00~19:00です。'
    },
    {
        q: '入場料はかかりますか？',
        a: '入場料は無料です。'
    },
    {
        q: '模擬店での支払い方法はなんですか？',
        a: '現金のみの対応となります。各模擬店にてお支払いください。'
    },
    {
        q: 'パンフレットはどこでもらえますか？',
        a: '本サイトのパンフレットページ(製作中)にてダウンロードするか、現地にてお配りしております。'
    }
  ];
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('components/_head', {
    title: 'よくあるご質問',
    pageCss: 'faq.css'
  }) %>
</head>

<body>
    <%- include('components/_background') %>

    <%- include('components/_header') %>

    <div class="menu-overlay"></div>
    <main class="main">
        <div class="faq-content" id="main-inner">
            <h2 class="faq-title" id="subtitle">よくあるご質問</h2>
            <% faqList.forEach(item => { %>
            <div class="faq-accordion_item">
                <button class="faq-accordion_question" type="button">
                    <span class="faq-accordion_question-text"><%= item.q %></span>
                </button>
                <div class="faq-accordion_answer"><%= item.a %></div>
            </div>
            <% }); %>
        </div>

    </main>

    <%- include('components/_footer') %>

    <script src="./js/index.js"></script>
    <script src="./js/faq.js"></script>
</body>

</html>