<%
const newsList = JSON.parse(include('data/news.json'));
%>


<!DOCTYPE html>
<html lang="ja">

<head>
    <%- include('components/_head', {
    title: 'トップページ',
    pageCss: 'index.css'
  }) %>
</head>

<body>
    <%- include('components/_background') %>

    <%- include('components/_header') %>

    <div class="menu-overlay"></div>
    <main class="main">
        <section class="top">
            <p class="sub-subtitle">神戸大学医学部</p>
            <h3 class="subtitle">大倉山祭 2026</h3>
            <h1 class="title">紡</h1>
            <p class="tagline">@大倉山公園 噴水広場</p>
            <span class="date">2026.11.1(日)</span>
            <span class="time">9:00〜19:00</span>
        </section>
        <section class="news" id="main-inner">
            <h2 class="news-title" id="subtitle">お知らせ</h2>
            <div class="news-content">
                <% newsList.slice(0, 3).forEach(item => { %>
                    <dl>
                        <dt><%= item.date %></dt>
                        <dd>
                            <% if (item.url) { %>
                                <a href="<%= item.url %>"><%= item.text %></a>
                            <% } else { %>
                                <%= item.text %>
                            <% } %>
                        </dd>
                    </dl>
                <% }); %>
                <!-- <div class="news-more">
                    
                    <a href="#">一覧を見る &rarr;</a>
                </div> -->
            </div>
        </section>
        <section class="about" id="main-inner">
            <h2 class="about-title" id="subtitle">大倉山祭とは</h2>
            <div class="about-content">
                <div class="img">
                    <img src="./images/about.jpg" alt="">
                </div>
                <div class="text">
                    <p>大倉山祭は神戸大学 医学部 楠キャンパスで<br>
                        毎年秋に開催される学園祭です。<br>
                        今年は11月1日(日)に開催します！<br>
                        模擬店、ステージ企画、お笑いライブなど、<br>
                        盛りだくさんの内容でお届けします！</p>
                    <a href="./about.html" class="more-btn">詳しくはこちら</a>
                </div>
            </div>
        </section>
        <section class="projects" id="main-inner">
            <h2 class="projects-title" id="subtitle">企画情報</h2>
            <div class="navigation">
                <a href="./projects.html" class="nav-button">
                    <img src="./images/illustration/shop.webp" alt="">
                    <span>模擬店紹介</span>
                </a>
                <a href="./timetable.html" class="nav-button">
                    <img src="./images/illustration/time3.webp" alt="">
                    <span>タイムテーブル</span>
                </a>
                <a href="./access.html" class="nav-button">
                    <img src="./images/illustration/map.webp" alt="">
                    <span>アクセス</span>
                </a>
                <a href="./faq.html" class="nav-button">
                    <img src="./images/illustration/question.webp" alt="">
                    <span>Q&A</span>
                </a>
            </div>
        </section>
        <section class="talk-show" id="main-inner">
            <h2 class="talk-show-title" id="subtitle">お笑いライブ</h2>
            <div class="talk-show-content">
                <div class="img">
                    <img src="./images/geinin.webp" alt="">
                </div>
                <div class="text">
                    <p class="talk-show-time-title" id="sub-subtitle">公演時間</p>
                    <p class="talk-show-time" id="sub-subtext">2026.11.1(日) 12:00〜13:00</p>
                    <p class="talk-show-place-title" id="sub-subtitle">会場</p>
                    <p class="talk-show-place" id="sub-subtext">メインステージ</p>
                    <p class="talk-show-guest-title" id="sub-subtitle">ゲスト一覧</p>
                    <p class="talk-show-guests" id="sub-subtext">ミサイルマン西代（MC）<br>ぼる塾<br>ラフ次元<br>バタハリ<br>苺ちゃん</p>
                    <p class="talk-show-notes">※写真動画撮影はご遠慮ください</p>
                </div>
            </div>
        </section>
    </main>
    <%- include('components/_footer') %>
    <script src="./js/index.js"></script>
</body>

</html>