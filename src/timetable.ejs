<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('components/_head', {
    title: 'タイムテーブル',
    pageCss: 'timetable.css'
  }) %>
</head>

<body>
    <%- include('components/_background') %>

    <%- include('components/_header') %>

    <div class="menu-overlay"></div>
    <main class="main">
        <div class="timetable" id="main-inner">
            <h2 class="timetable-title" id="subtitle">タイムテーブル</h2>
            <div class="content">
                <div class="timetable-note-wrapper">
                    <p class="timetable-note">
                        <!-- <i class="fa-solid fa-circle-info"></i> スケジュール名をクリックすると企画ポスターをご覧いただけます。 -->
                        スケジュール名をクリックすると企画ポスターをご覧いただけます。
                    </p>
                </div>
                <%
                const scheduleList = [
                    { time: '10:00~10:15', title: 'オープニング', images: '' },
                    { time: '10:15~10:45', title: '男の娘選手権', images: './images/timetable/femboy_contest.png' },
                    { time: '11:00~11:45', title: '看板娘', images: './images/timetable/girl_competition.png' },
                    { time: '12:00~13:00', title: 'お笑いライブ', images: './images/timetable/geinin.png' },
                    { time: '13:30~14:30', title: 'ダンスショー', images: './images/timetable/dance.png' },
                    { time: '15:00~17:30', title: '音楽ステージ', images: './images/timetable/classic_music.png,./images/timetable/band.png' },
                    { time: '17:45~18:30', title: 'ビンゴ大会', images: './images/timetable/bingo.png' },
                    { time: '18:30~18:45', title: 'エンディング', images: '' }
                ];
                %>
                <table class="timetable-table">
                    <thead class="timetable-head">
                        <tr>
                            <th>時間</th>
                            <th>スケジュール</th>
                        </tr>
                    </thead>
                    <tbody class="timetable-body">
                        <% scheduleList.forEach(function(item) { %>
                            <tr>
                                <td class="timetable-time"><%= item.time %></td>
                                <% if (item.images) { %>
                                    <td class="timetable-schedule has-image js-modal-trigger"
                                        data-title="<%= item.title %>"
                                        data-images="<%= item.images %>"
                                        role="button"
                                        tabindex="0"
                                        aria-haspopup="dialog"
                                        title="クリックしてポスターを見る">
                                        <div class="schedule-content">
                                            <span class="schedule-title"><%= item.title %></span>
                                            <span class="schedule-badge">
                                                <i class="fa-regular fa-image"></i> ポスターを見る
                                            </span>
                                        </div>
                                    </td>
                                <% } else { %>
                                    <td class="timetable-schedule">
                                        <div class="schedule-content">
                                            <span class="schedule-title"><%= item.title %></span>
                                        </div>
                                    </td>
                                <% } %>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <%- include('components/_footer') %>

    <!-- 画像モーダル (header/footerを含む画面全体を覆うためmain外に配置) -->
    <div class="timetable-modal js-timetable-modal" aria-hidden="true" role="dialog" aria-modal="true">
        <div class="timetable-modal-overlay js-modal-close"></div>
        <div class="timetable-modal-container">
            <div class="timetable-modal-header">
                <h3 class="timetable-modal-title js-modal-title">企画詳細</h3>
                <button type="button" class="timetable-modal-close js-modal-close" aria-label="閉じる">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="timetable-modal-body">
                <div class="timetable-modal-image-wrapper">
                    <img src="" alt="" class="timetable-modal-image js-modal-image">
                </div>
                <div class="timetable-modal-nav js-modal-nav" style="display: none;">
                    <button type="button" class="nav-btn prev js-nav-prev" aria-label="前のポスター">
                        <i class="fa-solid fa-chevron-left"></i> 前へ
                    </button>
                    <span class="nav-indicator js-nav-indicator">1 / 2</span>
                    <button type="button" class="nav-btn next js-nav-next" aria-label="次のポスター">
                        次へ <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="./js/index.js"></script>
    <script src="./js/timetable.js"></script>
</body>

</html>