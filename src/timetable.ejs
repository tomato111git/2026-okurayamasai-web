<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('components/_head', {
    title: 'タイムテーブル',
    pageCss: 'timetable.css'
  }) %>
</head>

<body>
    <%- include('components/_background') %>

    <%- include('components/_header') %>

    <div class="menu-overlay"></div>
    <main class="main">
        <div class="timetable" id="main-inner">
            <h2 class="timetable-title" id="subtitle">タイムテーブル</h2>
            <div class="content">
                <table class="timetable-table">
                    <thead class="timetable-head">
                        <tr>
                            <th>時間</th>
                            <th>スケジュール</th>
                        </tr>
                    </thead>
                    <tbody class="timetable-body">
                        <tr>
                            <td>10:00~10:15</td>
                            <td>オープニング</td>
                        </tr>
                        <tr>
                            <td>10:15~10:45</td>
                            <td>男の娘選手権</td>
                        </tr>
                        <tr>
                            <td>11:00~11:45</td>
                            <td>看板娘</td>
                        </tr>
                        <tr>
                            <td>12:00~13:00</td>
                            <td>お笑いライブ</td>
                        </tr>
                        <tr>
                            <td>13:30~14:30</td>
                            <td>ダンスショー</td>
                        </tr>
                        <tr>
                            <td>15:00~17:30</td>
                            <td>音楽ステージ</td>
                        </tr>
                        <tr>
                            <td>17:45~18:30</td>
                            <td>ビンゴ大会</td>
                        </tr>
                        <tr>
                            <td>18:30~18:45</td>
                            <td>エンディング</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <%- include('components/_footer') %>

    <script src="./js/index.js"></script>
</body>

</html>